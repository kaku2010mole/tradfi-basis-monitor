# Futu OpenD must be exposed through a small HTTP relay for hosted deployments.
FUTU_RELAY_URL=https://your-futu-relay.example.com/v1/quotes
# Optional bearer token used to authenticate calls from this dashboard.
FUTU_RELAY_TOKEN=
# Optional token for an OpenD pusher that sends books to Render instead of
# exposing a local relay. When omitted, the server derives it from SITE_PASSWORD.
FUTU_PUSH_TOKEN=
